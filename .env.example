# Server only. Never expose it to the browser (no NEXT_PUBLIC_ prefix).
PRAMAAN_API_KEY=
# Optional: another API address, such as a local dev API.
PRAMAAN_BASE_URL=
# 1 = use the built-in fake Pramaan (demo and tests). No calls leave the app.
PRAMAAN_FAKE=
# Optional, listings: 1 = look up a listing's location when it is saved (a charged call).
PRAMAAN_LISTING_GEOCODE=
# Optional, applications: how the notice email leaves, module (default) or capability.
PRAMAAN_NOTICE_TRANSPORT=
# With capability: an address on a domain you verified.
PRAMAAN_NOTICE_FROM=
# 1 = send an email notice of a new message through the app email module (messaging block).
PRAMAAN_MESSAGE_EMAIL=
